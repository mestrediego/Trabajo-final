# ---------- PUNTO A: limpiar un registro ----------
def limpiar_registro_sensor(registro_raw):
    #  saco los espacios
    sensor_id = registro_raw["sensor_id"].strip()

    #  Quitao los centigrados y cambiar la coma por puntos
    texto_temp = registro_raw["temperatura"]
    texto_temp = texto_temp.replace("°C", "").replace("°", "").replace("C", "")
    texto_temp = texto_temp.replace(",", ".").strip()

     
    try:
        temperatura = float(texto_temp)
    except ValueError:
        temperatura = 0.0

    # Ubicación: si falta, usar un valor por defecto
    ubicacion = registro_raw.get("ubicacion", "").strip()
    if ubicacion == "":
        ubicacion = "Ubicación no registrada"

    #  Devolver un diccionario nuevo
    return {
        "sensor_id": sensor_id,
        "temperatura": temperatura,
        "ubicacion": ubicacion,
    }


# ---------- PUNTO B: ----------
def generar_resumen_sensores(lista_sensores_limpios, umbral_temperatura):
    alertas = []       # IDs de sensores que superan el umbral
    suma = 0           # suma de todas las temperaturas válidas
    cantidad = 0       # cuántas temperaturas válidas hay

    for sensor in lista_sensores_limpios:
        temp = sensor["temperatura"]
        if temp is None:   
            continue

        suma = suma + temp
        cantidad = cantidad + 1

        if temp > umbral_temperatura:
            alertas.append(sensor["sensor_id"])

    if cantidad > 0:
        promedio = suma / cantidad
    else:
        promedio = None

    return alertas, promedio


